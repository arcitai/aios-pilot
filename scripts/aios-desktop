#!/usr/bin/env bash
# Build or open the isolated local pilot without changing an installed Buzz app.
set -euo pipefail

AIOS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$AIOS_ROOT"
AIOS_ACTION="${1:-help}"
if [[ $# -gt 1 ]]; then
  echo "Usage: scripts/aios-desktop {build|dev|open|doctor}" >&2
  exit 2
fi

case "$AIOS_ACTION" in
  help|-h|--help)
    echo "Usage: scripts/aios-desktop {build|dev|open|doctor}"
    echo "Local macOS pilot: isolated app identity, self-host relay on port 3341."
    echo "build: package a debug app with current agent tools; dev: run with Vite."
    echo "open: open the packaged app; doctor: check prerequisites and server."
    exit 0
    ;;
  build|dev|open|doctor) ;;
  *) echo "Unknown action: $AIOS_ACTION" >&2; exit 2 ;;
esac
if [[ "$(uname -s)" != Darwin ]]; then
  echo "This local app launcher targets macOS. The relay itself is portable." >&2
  exit 1
fi

# Do not let an ambient test identity, production updater, or baked provider
# secret become part of the pilot build. Runtime credentials stay in Settings.
unset BUZZ_PRIVATE_KEY BUZZ_SHARE_IDENTITY BUZZ_RESET_WEBVIEW_STATE
unset BUZZ_UPDATER_ENDPOINT BUZZ_UPDATER_PUBLIC_KEY
unset BUZZ_BUILD_AGENT_ENV BUZZ_BUILD_RELAY_RECONNECT_CMD
unset BUZZ_BUILD_BUZZ_AGENT_PROVIDER BUZZ_BUILD_BUZZ_AGENT_MODEL
unset BUZZ_DEV_KEYRING_SERVICE BUZZ_BUILD_AGENT_ACCESS_OWNER_ONLY
export BUZZ_BUILD_DEMO_SLUG=aios-pilot-local
export BUZZ_BUILD_AUTO_CONNECT_DEFAULT_RELAY=1
export BUZZ_RELAY_URL=ws://127.0.0.1:3341
export BUZZ_RELAY_HTTP=http://127.0.0.1:3341

if [[ "$AIOS_ACTION" == doctor ]]; then
  "$AIOS_ROOT/scripts/aios-selfhost" doctor
  curl --fail --silent --show-error --max-time 3 "$BUZZ_RELAY_HTTP/health" >/dev/null
  echo "PASS local relay health; app uses its own keyring, data directory and agent workspace."
  exit 0
fi

if [[ "$AIOS_ACTION" == build || "$AIOS_ACTION" == dev ]]; then
  AIOS_BUILD_REVISION="$(git rev-parse HEAD)"
  AIOS_BUILD_DIRTY=false
  if [[ -n "$(git status --porcelain)" ]]; then AIOS_BUILD_DIRTY=true; fi
  # shellcheck source=/dev/null
  source "$AIOS_ROOT/bin/activate-hermit"
  export CARGO_TARGET_DIR="$AIOS_ROOT/target"
  cargo build -p buzz-acp -p buzz-agent -p buzz-backend-kubernetes \
    -p buzz-dev-mcp -p buzz-cli -p git-credential-nostr
  AIOS_TARGET="$(rustc -vV | sed -n 's/^host: //p')"
  AIOS_CARGO_TARGET="$(cargo metadata --format-version 1 --no-deps | node -p "JSON.parse(require('fs').readFileSync(0, 'utf8')).target_directory")"
  for AIOS_BINARY in buzz-acp buzz-agent buzz-backend-kubernetes buzz-dev-mcp git-credential-nostr buzz; do
    install -m 755 "$AIOS_CARGO_TARGET/debug/$AIOS_BINARY" \
      "$AIOS_ROOT/desktop/src-tauri/binaries/$AIOS_BINARY-$AIOS_TARGET"
  done
  cd "$AIOS_ROOT/desktop"
  export CARGO_TARGET_DIR="$AIOS_ROOT/desktop/src-tauri/target"
  pnpm install --frozen-lockfile
  if [[ "$AIOS_ACTION" == dev ]]; then
    exec pnpm tauri dev --features mesh-llm --config src-tauri/tauri.aios.conf.json
  fi
  pnpm tauri build --debug --bundles app --features mesh-llm --config src-tauri/tauri.aios.conf.json
  AIOS_APP="$AIOS_ROOT/desktop/src-tauri/target/debug/bundle/macos/AIOS Pilot.app"
  # The upstream Info.plist pins Buzz's display name. Give this isolated
  # development bundle its own visible name before signing the final resources.
  /usr/libexec/PlistBuddy -c 'Set :CFBundleDisplayName AIOS Pilot' "$AIOS_APP/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c 'Set :CFBundleName AIOS Pilot' "$AIOS_APP/Contents/Info.plist"
  node --input-type=module - "$AIOS_APP" "$AIOS_BUILD_REVISION" "$AIOS_BUILD_DIRTY" <<'NODE'
import { writeFileSync } from 'node:fs';
import { join } from 'node:path';
const [app, revision, dirty] = process.argv.slice(2);
writeFileSync(join(app, 'Contents/Resources/aios-build.json'), JSON.stringify({
  revision, dirty: dirty === 'true', builtAt: new Date().toISOString(),
  distribution: 'local-development', relay: 'ws://127.0.0.1:3341',
}, null, 2) + '\n');
NODE
  # Tauri debug packaging does not seal the complete bundle. Ad-hoc signing
  # uses no developer identity, account, network service or notarization.
  for AIOS_BINARY in buzz-acp buzz-agent buzz-backend-kubernetes buzz-dev-mcp git-credential-nostr buzz; do
    codesign --force --sign - "$AIOS_APP/Contents/MacOS/$AIOS_BINARY"
  done
  codesign --force --sign - --entitlements "$AIOS_ROOT/desktop/src-tauri/Entitlements.plist" "$AIOS_APP"
  codesign --verify --deep --strict "$AIOS_APP"
  echo "Packaged AIOS Pilot. Open it with: scripts/aios-desktop open"
  exit 0
fi

AIOS_APP="$AIOS_ROOT/desktop/src-tauri/target/debug/bundle/macos/AIOS Pilot.app"
if [[ ! -d "$AIOS_APP" ]]; then
  echo "Build the app first: scripts/aios-desktop build" >&2
  exit 1
fi
if ! curl --fail --silent --max-time 3 "$BUZZ_RELAY_HTTP/health" >/dev/null; then
  echo "The local relay is unavailable. Start it with: scripts/aios-selfhost start" >&2
  exit 1
fi
exec open "$AIOS_APP"
